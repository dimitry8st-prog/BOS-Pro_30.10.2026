{
  "name": "bos-pro",
  "version": "0.0.0",
  "private": true,
  "description": "BOS.pro educational scenario contract v0.1. FixtureProvider only. Not a production server.",
  "type": "module",
  "engines": {
    "node": "24.12.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check": "tsc -p tsconfig.json --noEmit",
    "test": "tsc -p tsconfig.json && node --test dist/test/acceptance.test.js",
    "scenario:fixture": "tsc -p tsconfig.json && node dist/src/cli.js run --input fixtures/educational-input.json --store var/dev-store",
    "test:postgres": "tsc -p tsconfig.json && node --test dist/test/postgres.test.js",
    "migrate:postgres": "tsc -p tsconfig.json && node dist/src/storage/migrate-postgres.js",
    "scenario:postgres": "tsc -p tsconfig.json && node dist/src/scenario/educational-postgres.js"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.14",
    "@types/node": "24.19.2",
    "@types/pg": "8.23.1",
    "typescript": "7.0.2"
  },
  "dependencies": {
    "pg": "8.23.1"
  }
}
